# Copy this file to ".env" and paste your Team 13 / 327 Cherry Street credentials.
# The .env file is gitignored. Never commit real secrets or share them in chat.

# GraphQL machine-to-machine endpoint (from the credentials sheet "TARGET URL")
CA_API_URL=https://327cherry.stg.criticalasset.com/api

# OAuth2 client-credentials app credentials (from the credentials sheet)
CA_CLIENT_ID=paste_your_client_id_here
CA_CLIENT_SECRET=paste_your_client_secret_here

# Scopes to request (dot notation per the API reference)
CA_SCOPES=workorders.read assets.read locations.read

# Local server port
PORT=3000

# --- Challenge 02 (optional) ---
# If set, the Copilot uses a real LLM for structuring; otherwise it falls back
# to the built-in rule-based engine (works fully offline).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional NYC Open Data app token (raises Socrata rate limits; not required).
# NYC_APP_TOKEN=your_socrata_app_token

# Optional SMTP for actually sending agency emails. If unset, the app composes
# the email + logs it to the outbox, and you can use "Open in mail client".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM=facilities@327cherry.com
